# --- Vision / LLM providers -------------------------------------------------
# One of these enables real Vision-LLM calls in Agent 1 (Perception).
# If none are set/reachable, the system falls back to the deterministic
# MockVisionClient (useful for offline dev, CI, and demos without cost).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

VISION_PROVIDER=mock          # one of: mock | anthropic | openai | ollama
VISION_MODEL=claude-sonnet-5  # e.g. claude-sonnet-5 or gpt-4o (ignored for ollama)

# ollama: free, local, open-source vision inference - no API key, no cost,
# nothing leaves the machine. Install https://ollama.com, then
# `ollama pull moondream` (fast, ~1.7GB) or `ollama pull qwen2.5vl:7b`
# (slower, notably better OCR on small text like serial tags).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=moondream

# --- Vector DB (ChromaDB) ----------------------------------------------------
# Leave CHROMA_HOST unset to use an embedded PersistentClient (local dev,
# pytest). docker-compose sets CHROMA_HOST=chromadb to talk to the
# standalone Chroma server service instead.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./vector_store
CHROMA_COLLECTION_NAME=spare_parts_catalog
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Backend ------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=500

# --- Frontend -----------------------------------------------------------------
BACKEND_BASE_URL=http://localhost:8000
STREAMLIT_PORT=8501

# --- Verification Checkpoint thresholds ---------------------------------------
BLUR_VARIANCE_THRESHOLD=100.0
BRIGHTNESS_MIN=25.0
BRIGHTNESS_MAX=230.0
MIN_RESOLUTION_WIDTH=480
OCR_CONFIDENCE_THRESHOLD=0.80
RAG_SIMILARITY_THRESHOLD=0.70
MAX_STRUCTURED_OUTPUT_RETRIES=3
KEYFRAME_SAMPLE_INTERVAL_SEC=1.0
MAX_KEYFRAMES=24
